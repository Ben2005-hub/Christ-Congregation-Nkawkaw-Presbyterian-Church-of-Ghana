<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Church App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body class="bg-light">
    <header class="bg-white border-bottom">
      <nav class="container d-flex align-items-center justify-content-between py-2">
        <div>
          <a class="navbar-brand" href="/">Presbyterian Church</a>
          <a class="ms-3" href="/members/add">Sign up</a>
          <a class="ms-3" href="/messages/history">Messages</a>
        </div>
        <div>
          <a class="ms-3" href="/my-payments">My Payments</a>
          <a class="ms-3" href="/member">My Account</a>
          <% if (user) { %>
            <a class="me-3" href="/admin/signup">Create Admin</a>
            <a class="btn btn-sm btn-outline-secondary" href="/logout">Logout</a>
          <% } else { %>
            <a class="btn btn-sm btn-primary" href="/login">Admin</a>
          <% } %>
        </div>
      </nav>
    </header>
    <% if (flash) { %>
      <div class="container mt-3">
        <div class="alert alert-<%= flash.type || 'info' %>" role="alert">
          <%= flash.message %>
        </div>
      </div>
    <% } %>
    <main class="container py-4">
      <%- body %>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
