<h1 class="brand-heading">Member Details</h1>

<dl class="row">
  <dt class="col-sm-3">Name</dt>
  <dd class="col-sm-9"><%= member.name %></dd>

  <dt class="col-sm-3">Phone</dt>
  <dd class="col-sm-9"><%= member.phone %></dd>

  <dt class="col-sm-3">Email</dt>
  <dd class="col-sm-9"><%= member.email %></dd>

  <dt class="col-sm-3">Group</dt>
  <dd class="col-sm-9"><%= member.group_name %></dd>

  <dt class="col-sm-3">Gender</dt>
  <dd class="col-sm-9"><%= member.gender %></dd>

  <dt class="col-sm-3">Address</dt>
  <dd class="col-sm-9"><%= member.address %></dd>
</dl>
<hr>
<h3>Edit</h3>
<form method="POST" action="/members/<%= member.id %>?_method=PUT">
  <div class="mb-3">
    <label class="form-label">Full name</label>
    <input name="name" value="<%= member.name %>" class="form-control" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Phone</label>
    <input name="phone" value="<%= member.phone %>" class="form-control">
  </div>
  <div class="mb-3">
    <label class="form-label">Birthday</label>
    <input name="birthday" value="<%= member.birthday ? member.birthday.split('T')[0] : '' %>" class="form-control" type="date">
  </div>
  <div class="mb-3">
    <label class="form-label">Email</label>
    <input name="email" value="<%= member.email %>" class="form-control" type="email">
  </div>
  <div class="mb-3">
    <label class="form-label">Group/Ministry</label>
    <input name="group_name" value="<%= member.group_name %>" class="form-control">
  </div>
  <div class="mb-3">
    <label class="form-label">Address</label>
    <textarea name="address" class="form-control"><%= member.address %></textarea>
  </div>
  <button class="btn btn-primary">Save</button>
  <a class="btn btn-outline-primary ms-2" href="/messages/compose?preselect=<%= member.id %>">Message this member</a>
</form>

<hr>
<h3>Payments</h3>
<p>
  <strong>Tithe total:</strong> GHS <%= (totals && totals.tithe) ? Number(totals.tithe).toFixed(2) : '0.00' %>
  &nbsp; &nbsp;
  <strong>Funeral dues total:</strong> GHS <%= (totals && totals.funeral) ? Number(totals.funeral).toFixed(2) : '0.00' %>
</p>

<% if (payments && payments.length > 0) { %>
  <table class="table">
    <thead><tr><th>#</th><th>Type</th><th>Amount</th><th>Date</th><th>Reference</th><th></th></tr></thead>
    <tbody>
      <% payments.forEach(p => { %>
        <tr>
          <td><%= p.id %></td>
          <td><%= p.type %></td>
          <td>GHS <%= Number(p.amount).toFixed(2) %></td>
          <td><%= p.date ? (new Date(p.date)).toLocaleString() : '' %></td>
          <td><%= p.reference %></td>
          <td>
            <form method="POST" action="/payments/<%= p.id %>?_method=DELETE" onsubmit="return confirm('Delete this payment?');">
              <button class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } else { %>
  <p>No payments recorded for this member.</p>
<% } %>

<hr>
<h4>Add Payment</h4>
<form method="POST" action="/payments/add" class="row g-2 mb-3">
  <input type="hidden" name="member_id" value="<%= member.id %>">
  <div class="col-md-3">
    <select name="type" class="form-select" required>
      <option value="tithe">Tithe</option>
      <option value="funeral">Funeral</option>
      <option value="other">Other</option>
    </select>
  </div>
  <div class="col-md-3">
    <input name="amount" class="form-control" placeholder="Amount" required>
  </div>
  <div class="col-md-3">
    <input name="date" type="date" class="form-control">
  </div>
  <div class="col-md-3">
    <input name="reference" class="form-control" placeholder="Reference">
  </div>
  <div class="col-12 mt-2">
    <textarea name="note" class="form-control" placeholder="Optional note"></textarea>
  </div>
  <div class="col-12 mt-2">
    <button class="btn btn-success">Add payment</button>
  </div>
</form>
