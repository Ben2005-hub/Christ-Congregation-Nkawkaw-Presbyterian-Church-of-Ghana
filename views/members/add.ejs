<h1 class="brand-heading">Member Sign Up</h1>

<% if (typeof success !== 'undefined') { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>

<form action="/members/add" method="POST">
  <div class="mb-3">
    <label class="form-label">Full name</label>
    <input name="name" class="form-control" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Phone</label>
    <input name="phone" class="form-control">
  </div>
  <div class="mb-3">
    <label class="form-label">Birthday</label>
    <input name="birthday" class="form-control" type="date">
  </div>
  <div class="mb-3">
    <label class="form-label">Group/Ministry</label>
    <input name="group_name" class="form-control">
  </div>
  <div class="mb-3">
    <label class="form-label">Email</label>
    <input name="email" class="form-control" type="email">
  </div>
  <div class="mb-3">
    <label class="form-label">Gender</label>
    <select name="gender" class="form-select">
      <option value="">Select</option>
      <option>Male</option>
      <option>Female</option>
    </select>
  </div>
  <div class="mb-3">
    <label class="form-label">Address</label>
    <textarea name="address" class="form-control"></textarea>
  </div>
  <button class="btn btn-primary">Submit</button>
</form>
