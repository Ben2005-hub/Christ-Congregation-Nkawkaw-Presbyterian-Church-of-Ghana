# SMS Provider Configuration
# Arkesel (Akasel) SMS API - Get your API key from https://arkesel.com
SMS_PROVIDER=akasel
SMS_SENDER=CHURCH
AKASEL_API_URL=https://sms.arkesel.com/sms/api
AKASEL_API_KEY=your_arkesel_api_key_here

# Application Configuration
SESSION_SECRET=your_session_secret_key_here
PORT=3000
NODE_ENV=production

# Optional: Set SMS_PROVIDER=simulate to test SMS flows without sending real messages
# SMS_PROVIDER=simulate
