# SMS Provider Selection
# Options: 'akasel' (Arkesel), 'arkesel', 'mtmtn' (MTN), 'simulate' (for testing without real SMS)
SMS_PROVIDER=akasel
SMS_SENDER=CHURCH

# ========== Arkesel/Akasel SMS API (Ghana) - PRIMARY PROVIDER ==========
# Get your API key from https://arkesel.com
# Send SMS: https://sms.arkesel.com/sms/api?action=send-sms&api_key=KEY&to=PHONE&from=SENDER&sms=MESSAGE
# Check Balance: https://sms.arkesel.com/sms/api?action=check-balance&api_key=KEY&response=json
AKASEL_API_URL=https://sms.arkesel.com/sms/api
AKASEL_API_KEY=your_arkesel_api_key_here

# ========== MTN SMS (Ghana) API - FALLBACK PROVIDER ==========
MTN_SMS_BASE=https://api.mtn.com
MTN_TOKEN_URL=https://api.mtn.com/v1/oauth/access_token/accesstoken
MTN_CLIENT_ID=your_mtn_client_id
MTN_CLIENT_SECRET=your_mtn_client_secret
MTN_SMS_SENDER=yourshortcode
MTN_SUBSCRIPTION_KEY=your_mtn_subscription_key

# ========== Application Configuration ==========
SESSION_SECRET=your_session_secret_key_here
PORT=3000
NODE_ENV=production

# ========== MTN Webhooks (if using MTN) ==========
MTN_CALLBACK_URL=https://christcongregationnkawkaw.vercel.app/webhook/mtn/sms
MTN_WEBHOOK_SECRET=your_webhook_secret_from_mtn_portal

# ========== Optional: Simulation Mode ==========
# Set SMS_PROVIDER=simulate to test SMS flows without making real API calls
# SMS_PROVIDER=simulate
