# MTN SMS (Ghana) example values
# Base SMS API endpoint (from MTN Ghana portal)
MTN_SMS_BASE=https://api.sandbox.mtn.com
# Token endpoint (portal should provide exact path)
MTN_TOKEN_URL=https://api.sandbox.mtn.com/token
# Subscription key from portal
MTN_SUBSCRIPTION_KEY=your_subscription_key_here
# API user (or client) credentials
MTN_API_USER_ID=your_api_user_id
MTN_API_USER_KEY=your_api_user_key
# Alternatively (if portal uses client credentials):
MTN_CLIENT_ID=your_client_id
MTN_CLIENT_SECRET=your_client_secret
# Sender address/shortcode assigned by MTN
MTN_SMS_SENDER=yourshortcode

# App config
SESSION_SECRET=some_secret_here
PORT=3000
# If your app is hosted publicly (e.g. Vercel), set the callback URL you will register in MTN portal
MTN_CALLBACK_URL=https://christcongregationnkawkaw.vercel.app/webhook/mtn
MTN_WEBHOOK_SECRET=your_webhook_secret_from_portal
